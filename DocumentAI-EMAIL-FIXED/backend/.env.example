NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/documentai?retryWrites=true&w=majority
MONGODB_URI=

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=7d

FRONTEND_URL=http://localhost:5173

# Cloudinary — document storage (files are never kept on local disk)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Reserved for a future standalone NLP microservice. The current build
# runs the NLP engine in-process (backend/nlp) — this is not required
# unless NLP_MODE=service is set.
NLP_SERVICE_URL=http://localhost:8000

MAX_FILE_SIZE_MB=20

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Stricter limiter applied to /api/auth/* (login, register, captcha)
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=30

# Brevo API — transactional signup OTP + password reset emails
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=DocumentAI
# Optional: where replies to transactional emails should go
MAIL_REPLY_TO_EMAIL=docuaisupport@gmail.com
MAIL_REPLY_TO_NAME=DocumentAI Support
PASSWORD_RESET_EXPIRE_MINUTES=30
REGISTRATION_OTP_EXPIRE_MINUTES=10

# Google Identity Services
GOOGLE_CLIENT_ID=


# IMPORTANT: MAIL_FROM_EMAIL must be a sender/domain verified in Brevo.
# FRONTEND_URL must be your real deployed frontend URL (not localhost) for password-reset links.
# Example: FRONTEND_URL=https://your-frontend.vercel.app
