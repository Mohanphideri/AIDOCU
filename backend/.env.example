# ==============================
# SERVER
# ==============================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ==============================
# DATABASE
# ==============================
MONGODB_URI=mongodb://localhost:27017/university_cbt

# ==============================
# AUTH / SESSION
# ==============================
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=8h
SESSION_SECRET=replace_with_a_long_random_string
BCRYPT_SALT_ROUNDS=12

# ==============================
# EMAIL - BREVO
# ==============================
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@university.edu
BREVO_SENDER_NAME=University Examination Cell

# ==============================
# UNIVERSITY DOMAIN (never hard-code in code, configure per-university in DB;
# this is only a fallback used by seed data)
# ==============================
DEFAULT_UNIVERSITY_EMAIL_DOMAIN=university.edu

# ==============================
# VERIFICATION / RESET POLICY
# ==============================
VERIFICATION_CODE_EXPIRY_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

# ==============================
# RATE LIMITING
# ==============================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ==============================
# MEDIA / WEBRTC (placeholder for future dedicated media server)
# ==============================
MEDIA_SERVER_URL=
